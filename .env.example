# ─────────────────────────────────────────────────────────────
# Capstone Booking Platform — Environment Template
#
# Copy this file to `.env` and fill in the values marked <REQUIRED>.
# Every other key has a working default for local development.
#
# Minimum steps to boot a fresh install:
#   1. cp .env.example .env
#   2. Fill in APP_KEY (run: php artisan key:generate)
#   3. Set DB_* to your MySQL credentials
#   4. Set LEGAL_CONTROLLER_* to your organization's details
#   5. (Optional) Set MAIL_* and PAYMONGO_* for full functionality
#   6. php artisan migrate:fresh --seed
#   7. php artisan storage:link
#   8. npm install && npm run build
#
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────

APP_NAME="Capstone"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ── Performance ──────────────────────────────────────────────
# Any query slower than this many milliseconds is written to
# storage/logs/slow-queries.log as one JSON line per query, then
# aggregated into the /platform/health/queries dashboard by the
# `slow-queries:harvest` scheduled command.
#
# Default when unset: 200ms in local, 500ms in production.

# SLOW_QUERY_MS=200

# ── Security ─────────────────────────────────────────────────

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────
# The application is developed and deployed on MySQL / MariaDB.
# SQLite is supported for testing (see phpunit.xml) but the seed
# data and migrations assume MySQL.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Capstone
DB_USERNAME=root
DB_PASSWORD=

# SQLite alternative (used by automated tests):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# ── Session ──────────────────────────────────────────────────
# Sessions are stored in the database by default so the app works
# across multiple workers without sticky sessions.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Broadcasting & Queue ─────────────────────────────────────

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

# ── Filesystem ───────────────────────────────────────────────
# The `public` disk is served via the public/storage symlink,
# created by `php artisan storage:link`. Do not change this to
# `local` unless you intend to break file uploads.

FILESYSTEM_DISK=public

# ── Cache ────────────────────────────────────────────────────
# The database cache store is used so the cache survives restarts
# and works across multiple workers.

CACHE_STORE=database
# CACHE_PREFIX=

# ── Redis (optional) ─────────────────────────────────────────
# Only needed if you switch CACHE_STORE, SESSION_DRIVER, or
# QUEUE_CONNECTION to `redis`.

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────
# The platform sends transactional mail (booking confirmations,
# KYB decisions, password resets, permit expiry reminders).
#
# Two configurations are supported:
#   - `log`   → writes mail to storage/logs/laravel.log (dev default)
#   - `smtp`  → real delivery via Gmail, Mailgun, Postmark, etc.
#
# Gmail SMTP requires:
#   1. 2-Step Verification enabled on the Google account
#   2. A 16-character App Password from
#      https://myaccount.google.com/apppasswords
#   3. The App Password must be wrapped in DOUBLE QUOTES —
#      it contains spaces that .env parsers would otherwise truncate.
#
# If mail is misconfigured the app still works; observer mail
# failures are wrapped in a try/catch and logged as warnings.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_ENCRYPTION=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP example (replace the credentials):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME="<your-gmail-address>"
# MAIL_PASSWORD="<16-char-app-password>"
# MAIL_FROM_ADDRESS="<your-gmail-address>"

# ── Image Compression ────────────────────────────────────────
# Every image uploaded through the platform is compressed until it
# fits under the per-context ceiling defined in config/images.php.
# These env keys only override the system-wide defaults; the
# per-context overrides (avatars, kyb-document, property, etc.)
# live in config/images.php and are not env-driven.

IMAGE_MAX_KB=2048
IMAGE_MAX_WIDTH=2560
IMAGE_MAX_HEIGHT=2560
IMAGE_AUTO_ORIENTATE=true
IMAGE_STRIP_EXIF=true
IMAGE_PREFER_WEBP=false

# Driver: 'gd' (default, ships with PHP) or 'imagick' (faster,
# requires the imagick PHP extension). If 'imagick' is requested
# but the extension isn't loaded, the service falls back to GD.

IMAGE_DRIVER=gd

# ── Livewire ─────────────────────────────────────────────────
# Temporary file uploads use the default filesystem disk when unset.
# Only needed if you want temporary uploads on a different disk
# (e.g. `local` to keep them off the public symlink).

# LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# ── AWS S3 (optional) ────────────────────────────────────────
# Only needed if you set FILESYSTEM_DISK=s3.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite ─────────────────────────────────────────────────────

VITE_APP_NAME="${APP_NAME}"

# ── Legal / GDPR ─────────────────────────────────────────────
# Used by the privacy policy page (config/legal.php) and the
# register form's consent checkbox. The Data Protection Officer
# fields can be left blank if you don't have a designated DPO —
# the privacy policy page handles empty values gracefully.

LEGAL_CONTROLLER_NAME="<organization name>"
LEGAL_CONTROLLER_EMAIL="<data-controller email>"
LEGAL_DPO_NAME=""
LEGAL_DPO_EMAIL=""

# ── PayMongo (optional) ──────────────────────────────────────
# Required for online payment processing. Without these keys,
# the booking flow still works up to the payment step; the
# payment service logs an error and returns a graceful failure.
#
# Get TEST keys at https://dashboard.paymongo.com/developers
# Set PAYMONGO_TEST_MODE=false when switching to live keys.

PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_TEST_MODE=true